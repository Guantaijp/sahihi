# Server
PORT=3000

# Optional LLM polish layer (rephrasing only — never adds facts). Leave
# false for a demo you don't want dependent on a live API call.
USE_LLM_COMPOSER=false

# Which LLM does the rephrasing: "mistral" (default) or "anthropic".
LLM_PROVIDER=mistral

# Mistral AI — https://console.mistral.ai
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# Anthropic — only needed if LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# WhatsApp Business API (Meta Graph API) — leave blank to use the console
# log stub instead, e.g. while waiting on Business API approval.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# App secret from Meta dashboard (App settings → Basic). When set, every
# webhook POST must carry a valid X-Hub-Signature-256 or it's rejected.
WHATSAPP_APP_SECRET=
# Approved Meta message template used for deadline reminders. Required in
# production: Meta blocks free-form messages more than 24h after the user's
# last message. Leave blank locally to send plain text via the console stub.
# Body must take 2 variables: {{1}} notice title, {{2}} deadline.
WHATSAPP_REMINDER_TEMPLATE=
WHATSAPP_REMINDER_TEMPLATE_LANG=en
WHATSAPP_VERIFY_TOKEN=choose-any-string-and-reuse-it-in-meta-dashboard

# Where sessions + reminders are saved so they survive restarts. Set to an
# empty value to keep them in memory only.
SESSION_STORE_PATH=data/sessions.json
